{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "presupuestos",
	"main": "src/index.js",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*",
			"/p/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "presupuestos",
			// Reemplazar por el id que devuelve: npx wrangler d1 create presupuestos
			"database_id": "ae8bb6f4-5707-4ffc-8497-605ee04aee1b",
			"migrations_dir": "migrations"
		}
	],
	"observability": {
		"enabled": true
	}
}